generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("NEXT_PRIVATE_DATABASE_URL")
}

// schema.prisma (only the Auth model changed: role -> roles)
model Auth {
  id                           Int                            @id @default(autoincrement())
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  email                        String                         @unique
  phone                        String?                        @unique
  firstName                    String
  lastName                     String
  password                     String
  roles                        Role[]                         @default([])
  referralProducts             ReferralProducts[]
  adminStripeConnectId         String?                        @unique
  adminStripeConnectIdStatus   Boolean?                       @default(false)
  Checkouts                    Checkout[]
  Subscription                 Subscription[]
  referredSales                Auth[]                         @relation("AffiliateToSales")
  referredBy                   Auth?                          @relation("AffiliateToSales", fields: [referredById], references: [id])
  referredById                 Int?
  digitalBillboards            DigitalBillboard[]
  emailMarketingCredentials    emailMarketingCredentials[]
  emailUsers                   EmailUser[]
  EmailJobResult               EmailJobResult[]
  AdminPayouts                 AdminPayouts[]
  AdminRevenue                 AdminRevenue[]
  Notes                        Notes[]
  emailSentHistories           EmailSentHistory[]
  googleMicrosoftAccountTokens GoogleMicrosoftAccountTokens[]
  otp                          Int                            @default(0)
  otpExpirationDate            DateTime?
  otpVerified                  Boolean                        @default(false)

  // NEW: Newsletter relations
  newsletterJobResults EmailJobResult[]   @relation("NewsletterRecipient")
  newsletterHistories  EmailSentHistory[] @relation("NewsletterHistory")
  contracts            Contract[]
  invoices             Invoice[]
  toolFeedbacks        ToolFeedback[]
}

enum Role {
  Affiliate
  SuperAffiliate
  Sales
  Admin
  NewsLetter
  Rsvp
  DigitalBillboard
  EmailMarketing
  InvoiceTool
  LightningSilver
  LightningGold
}

model AdminPayouts {
  id                   Int      @id @default(autoincrement())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  amount               String
  adminStripeConnectId String
  auth                 Auth     @relation(fields: [authId], references: [id])
  authId               Int
}

model GoogleMicrosoftAccountTokens {
  id                String @id @default(cuid())
  authId            Int
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String? @db.Text
  id_token      String? @db.Text
  session_state String?
  auth          Auth    @relation(fields: [authId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([authId])
}

model emailMarketingCredentials {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  email       String
  appPassword String
  authId      Int      @unique

  Auth               Auth               @relation(fields: [authId], references: [id])
  emailSentHistories EmailSentHistory[]
}

model ReferralProducts {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  productName String
  productLink String
  Auth        Auth     @relation(fields: [authId], references: [id])
  authId      Int

  conversion             Int                      @default(0)
  comission              Int                      @default(0)
  referralProductsClicks ReferralProductsClicks[]

  @@unique([authId, productLink])
  @@index([authId])
}

model ReferralProductsClicks {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clicks             Int              @default(0)
  ReferralProducts   ReferralProducts @relation(fields: [referralProductsId], references: [id])
  referralProductsId Int
}

model AdminRevenue {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  revenue   Int      @default(0)
  Auth      Auth     @relation(fields: [authId], references: [id])
  authId    Int      @unique

  @@index([authId])
}

model EmailUser {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String
  fullName  String
  optType   String   @default("default")

  auth               Auth               @relation(fields: [authId], references: [id])
  authId             Int
  emailUserCSV       EmailUserCSV?      @relation(fields: [emailUserCSVId], references: [id], onDelete: SetNull)
  emailUserCSVId     Int? // nullable during backfill
  EmailJobResult     EmailJobResult[]
  emailSentHistories EmailSentHistory[]

  @@unique([authId, email])
  @@index([authId])
  @@index([emailUserCSVId]) // helpful for ?csvId= queries
}

model EmailUserCSV {
  id         Int         @id @default(autoincrement())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  name       String
  emailUsers EmailUser[]
}

model EmailJobResult {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  // content
  subject String
  text    String?
  html    String?

  // scheduling
  runAt               DateTime?
  repeated            Boolean?  @default(false)
  timeInterval        Int? // seconds
  weekdays            Int[]
  rotationSpanSeconds Int?

  // NEW: newsletter flag
  isNewsletter Boolean @default(false)

  // bookkeeping
  auth   Auth @relation(fields: [authId], references: [id])
  authId Int

  // For email users (existing)
  emailUser   EmailUser? @relation(fields: [emailUserId], references: [id])
  emailUserId Int?

  // NEW: For newsletter (Auth users with NewsLetter role)
  newsletterAuth   Auth? @relation("NewsletterRecipient", fields: [newsletterAuthId], references: [id])
  newsletterAuthId Int?

  status             EmailStatus        @default(pending)
  emailSentHistories EmailSentHistory[]

  @@index([authId])
  @@index([emailUserId])
  @@index([newsletterAuthId])
  @@index([status, runAt])
}

enum EmailStatus {
  pending
  processing
  sent
  failed
}

model EmailSentHistory {
  id           String      @id @default(cuid())
  createdAt    DateTime    @default(now())
  sentAt       DateTime?
  subject      String
  text         String?
  html         String?
  status       EmailStatus @default(sent)
  messageId    String?
  errorMessage String?

  // Relations
  auth   Auth @relation(fields: [authId], references: [id])
  authId Int

  // For email users
  emailUser   EmailUser? @relation(fields: [emailUserId], references: [id])
  emailUserId Int?

  // NEW: For newsletter recipients
  newsletterAuth   Auth? @relation("NewsletterHistory", fields: [newsletterAuthId], references: [id])
  newsletterAuthId Int?

  credentials   emailMarketingCredentials? @relation(fields: [credentialsId], references: [id])
  credentialsId Int?

  jobResult   EmailJobResult? @relation(fields: [jobResultId], references: [id])
  jobResultId String?

  @@index([authId])
  @@index([emailUserId])
  @@index([newsletterAuthId])
  @@index([credentialsId])
  @@index([jobResultId])
  @@index([status])
}

model User {
  id                Int         @id @default(autoincrement())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deleted           Boolean     @default(false)
  cognitoId         String?     @unique
  email             String?     @unique
  phone             String?
  firstName         String?
  lastName          String?
  roleId            Int
  disabled          Boolean
  digitalBillboards Int         @default(0)
  pageHits          Int         @default(0)
  Advertiser        Advertiser?
  Affiliate         Affiliate?
  SignUp            SignUp[]
}

model SignUp {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deleted     Boolean    @default(false)
  userId      Int?
  calendarId  Int
  affiliateId Int?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])
  calendar    Calendar   @relation(fields: [calendarId], references: [id])
  salesMember User?      @relation(fields: [userId], references: [id])
}

model Calendar {
  id                 Int                   @id @default(autoincrement())
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  date               DateTime
  time               String
  limit              Int?
  compareDate        DateTime              @default(now())
  SignUp             SignUp[]
  userBroughtProduct UserBroughtProducts[]
}

model UserBroughtProducts {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  email      String?  @unique
  phone      String?
  firstName  String?
  lastName   String?
  calendarId Int
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model NewsLetter {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
  email     String
  firstName String
  lastName  String
}

model NewsLetterContent {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
  published Boolean  @default(false)
  title     String
  content   String
}

model Checkout {
  id                Int       @id @default(autoincrement())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deleted           Boolean   @default(false)
  transactionId     String?
  AuthId            Int
  amount            Float
  paid              Boolean   @default(false)
  period            String    @default("") // montly/yearly
  auth              Auth      @relation(fields: [AuthId], references: [id])
  product           String?
  cancelSubscripton Boolean
  nextBillingDate   DateTime?
  startDate         DateTime?
}

model FrequentQuestions {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
  title     String
  text      String
}

model Affiliate {
  id                Int      @id @default(autoincrement())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deleted           Boolean  @default(false)
  approved          Boolean
  link              String
  uuid              String
  userId            Int      @unique
  digitalBillboards Int      @default(0)
  pageHits          Int      @default(0)
  User              User     @relation(fields: [userId], references: [id])
  SignUp            SignUp[]
}

model Careers {
  id          Int          @id @default(autoincrement())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deleted     Boolean      @default(false)
  title       String?
  description String?
  location    String?
  salary      Int?
  image       String?
  type        Type
  Applicants  Applicants[]
}

enum Type {
  Job
  Recruitment
}

model Applicants {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
  careersId Int
  firstName String
  lastName  String
  email     String
  phone     String
  resume    String
  career    Careers  @relation(fields: [careersId], references: [id])
}

model Consultation {
  id                      Int      @id @default(autoincrement())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  deleted                 Boolean  @default(false)
  fullName                String
  companyName             String
  location                String
  jobTitle                String
  email                   String
  phone                   String
  numOfPositions          Int
  dateTime                DateTime
  totalAmount             Int
  currency                String
  stripeCheckoutSessionId String
  stripePaymentIntentId   String
  paidAt                  DateTime
  status                  String   @default("pending")
}

model Blogpost {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deleted     Boolean  @default(false)
  title       String
  slug        String   @unique
  postContent String
  category    String
  views       Int      @default(0)
  headerImage String?
  featured    Boolean  @default(false)
}

model Subscription {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deleted       Boolean  @default(false)
  transactionId String?
  amount        Float
  paid          Boolean  @default(false)
  AuthId        Int      @unique
  auth          Auth     @relation(fields: [AuthId], references: [id])
}

model Notes {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  title      String
  content    String
  authorName String?
  auth       Auth     @relation(fields: [authId], references: [id])
  authId     Int
}

model Advertiser {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deleted       Boolean  @default(false)
  approved      Boolean?
  userId        Int      @unique
  website       String?
  twitter       String?
  youtube       String?
  facebook      String?
  linkedIn      String?
  instagram     String?
  businessImage String?
  companyName   String?
  podcast       String?
  companyBlurb  String?
  User          User     @relation(fields: [userId], references: [id])
}

model Legal {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
  title     String
  content   String?
}

model AffiliateAgreement {
  id                 Int      @id @default(autoincrement())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  affiliateAgreement String
}

model Gdpr {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gdpr      String
}

model Terms {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  terms     String
}

model RiskDisclosure {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  riskDisclosure String
}

model PrivacyPolicy {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  privacyPolicy String
}

model DigitalBillboard {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  fullName    String
  website     String
  podcast     String
  twitter     String
  youTube     String
  facebook    String
  image       String
  companyName String
  description String
  status      Status
  authId      Int? // optional foreign key
  Auth        Auth?    @relation(fields: [authId], references: [id]) // optional relation
}

enum Status {
  Approved
  NotApproved
  Rejected
}

// invoice 

model Contract {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  name         String   @default("")
  contractName String   @default("")
  email        String   @default("")

  businessName String @default("")
  pdf          String
  signed       String @default("notSigned")

  authId   Int?
  Auth     Auth?     @relation(fields: [authId], references: [id])
  invoices Invoice[]
}

model Invoice {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  name         String   @default("")
  email        String   @default("")
  businessName String   @default("")
  price        String   @default("")

  image         String  @default("")
  transactionId String?
  paid          Boolean @default(false)

  contractId Int?
  Contract   Contract? @relation(fields: [contractId], references: [id])

  authId Int?
  auth   Auth? @relation(fields: [authId], references: [id])
}

model ToolFeedback {
  id        Int      @id @default(autoincrement())
  authId    Int
  review    String
  stars     String
  toolName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Auth Auth @relation(fields: [authId], references: [id])
}
