generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("NEXT_PRIVATE_DATABASE_URL")
}

// schema.prisma (only the Auth model changed: role -> roles)
model Auth {
  id                           Int                            @id @default(autoincrement())
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  email                        String                         @unique
  phone                        String?                        @unique
  firstName                    String
  lastName                     String
  password                     String
  roles                        Role[]                         @default([])
  referralProducts             ReferralProducts[]
  adminStripeConnectId         String?                        @unique
  adminStripeConnectIdStatus   Boolean?                       @default(false)
  Checkouts                    Checkout[]
  Subscription                 Subscription[]
  referredSales                Auth[]                         @relation("AffiliateToSales")
  referredBy                   Auth?                          @relation("AffiliateToSales", fields: [referredById], references: [id])
  referredById                 Int?
  digitalBillboards            DigitalBillboard[]
  emailMarketingCredentials    emailMarketingCredentials[]
  emailUsers                   EmailUser[]
  EmailJobResult               EmailJobResult[]
  AdminPayouts                 AdminPayouts[]
  AdminRevenue                 AdminRevenue[]
  Notes                        Notes[]
  emailSentHistories           EmailSentHistory[]
  googleMicrosoftAccountTokens GoogleMicrosoftAccountTokens[]
  otp                          Int                            @default(0)
  otpExpirationDate            DateTime?
  otpVerified                  Boolean                        @default(false)
  status                       String                         @default("active")

  // Stripe customer that owns the user's payment methods
  stripeCustomerId String? @unique

  // Monthly included emails
  emailUsageLimit Int @default(100000)

  // Dollars per overage email.
  // $0.005 = half a cent.
  emailOverageRate Float @default(0.005)

  newsletterJobResults EmailJobResult[]   @relation("NewsletterRecipient")
  newsletterHistories  EmailSentHistory[] @relation("NewsletterHistory")
  contracts            Contract[]
  invoices             Invoice[]
  toolFeedbacks        ToolFeedback[]
  subscriptionInvs     SubscriptionInv[]

  emailUsages         EmailUsage[]
  emailOverageCharges EmailOverageCharge[]
}

model EmailUsage {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authId Int
  auth   Auth @relation(fields: [authId], references: [id], onDelete: Cascade)

  // Calendar month, e.g. "2026-08"
  month String

  // Successfully sent emails during this month
  count Int @default(0)

  // Snapshot when this monthly record was created.
  // This stops changing a user's limit later from altering old bills.
  includedLimit Int @default(100000)

  // $0.005 = 5,000 micro-dollars.
  //
  // $1.00 = 1,000,000 micro-dollars
  // $0.01 =    10,000 micro-dollars
  // $0.005 =    5,000 micro-dollars
  overageRateMicros Int @default(5000)

  // Exact monetary amount already successfully charged against
  // this monthly usage record.
  overageBilledMicros BigInt @default(0)

  // Legacy field. Keep temporarily if you already have it.
  // New billing code does NOT use this field.
  overageBilled Int @default(0)

  @@unique([authId, month])
  @@index([authId])
}

enum EmailOverageChargeStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REQUIRES_ACTION
}

model EmailOverageCharge {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authId Int
  auth   Auth @relation(fields: [authId], references: [id], onDelete: Cascade)

  // UTC date, e.g. "2026-08-31"
  billingDate String

  // Stripe works in integer cents.
  // Example:
  // 100 overage emails * $0.005 = 50 cents
  amountCents Int

  // Exact amount from EmailUsage that this charge covers.
  coveredMicros BigInt

  status EmailOverageChargeStatus @default(PENDING)

  stripePaymentIntentId String? @unique
  stripePaymentMethodId String?

  // Base idempotency key for the daily billing record.
  idempotencyKey String @unique

  failureCode    String?
  failureMessage String?

  chargedAt DateTime?

  // Set in same DB transaction that applies coveredMicros
  // to EmailUsage rows.
  usageAppliedAt DateTime?

  @@unique([authId, billingDate])
  @@index([authId])
  @@index([status])
}

enum Role {
  Affiliate
  SuperAffiliate
  Sales
  Admin
  NewsLetter
  Rsvp
  DigitalBillboard
  EmailMarketing
  InvoiceTool
  LightningSilver
  LightningGold
}

model AdminPayouts {
  id                   Int      @id @default(autoincrement())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  amount               String
  adminStripeConnectId String
  auth                 Auth     @relation(fields: [authId], references: [id])
  authId               Int
}

model GoogleMicrosoftAccountTokens {
  id                String @id @default(cuid())
  authId            Int
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String? @db.Text
  id_token      String? @db.Text
  session_state String?
  auth          Auth    @relation(fields: [authId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([authId])
}

model emailMarketingCredentials {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  email       String
  appPassword String
  authId      Int      @unique

  Auth               Auth               @relation(fields: [authId], references: [id])
  emailSentHistories EmailSentHistory[]
}

model ReferralProducts {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  productName String
  productLink String
  Auth        Auth     @relation(fields: [authId], references: [id])
  authId      Int

  conversion             Int                      @default(0)
  comission              Int                      @default(0)
  referralProductsClicks ReferralProductsClicks[]

  @@unique([authId, productLink])
  @@index([authId])
}

model ReferralProductsClicks {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clicks             Int              @default(0)
  ReferralProducts   ReferralProducts @relation(fields: [referralProductsId], references: [id])
  referralProductsId Int
}

model AdminRevenue {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  revenue   Int      @default(0)
  Auth      Auth     @relation(fields: [authId], references: [id])
  authId    Int      @unique

  @@index([authId])
}

model EmailUser {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String
  fullName  String
  optType   String   @default("default")

  auth               Auth               @relation(fields: [authId], references: [id])
  authId             Int
  emailUserCSV       EmailUserCSV?      @relation(fields: [emailUserCSVId], references: [id], onDelete: SetNull)
  emailUserCSVId     Int? // nullable during backfill
  EmailJobResult     EmailJobResult[]
  emailSentHistories EmailSentHistory[]

  @@unique([authId, email])
  @@index([authId])
  @@index([emailUserCSVId]) // helpful for ?csvId= queries
}

model EmailUserCSV {
  id         Int         @id @default(autoincrement())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  name       String
  emailUsers EmailUser[]
}

model EmailJobResult {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  // content
  subject String
  text    String?
  html    String?

  // scheduling
  runAt               DateTime?
  repeated            Boolean?  @default(false)
  timeInterval        Int? // seconds
  weekdays            Int[]
  rotationSpanSeconds Int?

  // NEW: newsletter flag
  isNewsletter Boolean @default(false)

  // bookkeeping
  auth   Auth @relation(fields: [authId], references: [id])
  authId Int

  // For email users (existing)
  emailUser   EmailUser? @relation(fields: [emailUserId], references: [id])
  emailUserId Int?

  // NEW: For newsletter (Auth users with NewsLetter role)
  newsletterAuth   Auth? @relation("NewsletterRecipient", fields: [newsletterAuthId], references: [id])
  newsletterAuthId Int?

  status             EmailStatus        @default(pending)
  emailSentHistories EmailSentHistory[]

  @@index([authId])
  @@index([emailUserId])
  @@index([newsletterAuthId])
  @@index([status, runAt])
}

enum EmailStatus {
  pending
  processing
  sent
  failed
}

model EmailSentHistory {
  id           String      @id @default(cuid())
  createdAt    DateTime    @default(now())
  sentAt       DateTime?
  subject      String
  text         String?
  html         String?
  status       EmailStatus @default(sent)
  messageId    String?
  errorMessage String?

  // Relations
  auth   Auth @relation(fields: [authId], references: [id])
  authId Int

  // For email users
  emailUser   EmailUser? @relation(fields: [emailUserId], references: [id])
  emailUserId Int?

  // NEW: For newsletter recipients
  newsletterAuth   Auth? @relation("NewsletterHistory", fields: [newsletterAuthId], references: [id])
  newsletterAuthId Int?

  credentials   emailMarketingCredentials? @relation(fields: [credentialsId], references: [id])
  credentialsId Int?

  jobResult   EmailJobResult? @relation(fields: [jobResultId], references: [id])
  jobResultId String?

  @@index([authId])
  @@index([emailUserId])
  @@index([newsletterAuthId])
  @@index([credentialsId])
  @@index([jobResultId])
  @@index([status])
}

model User {
  id                Int         @id @default(autoincrement())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deleted           Boolean     @default(false)
  cognitoId         String?     @unique
  email             String?     @unique
  phone             String?
  firstName         String?
  lastName          String?
  roleId            Int
  disabled          Boolean
  digitalBillboards Int         @default(0)
  pageHits          Int         @default(0)
  Advertiser        Advertiser?
  Affiliate         Affiliate?
  SignUp            SignUp[]
}

model SignUp {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deleted     Boolean    @default(false)
  userId      Int?
  calendarId  Int
  affiliateId Int?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])
  calendar    Calendar   @relation(fields: [calendarId], references: [id])
  salesMember User?      @relation(fields: [userId], references: [id])
}

model Calendar {
  id                 Int                   @id @default(autoincrement())
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  date               DateTime
  time               String
  limit              Int?
  compareDate        DateTime              @default(now())
  SignUp             SignUp[]
  userBroughtProduct UserBroughtProducts[]
}

model UserBroughtProducts {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  email      String?  @unique
  phone      String?
  firstName  String?
  lastName   String?
  calendarId Int
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model NewsLetter {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
  email     String
  firstName String
  lastName  String
}

model NewsLetterContent {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
  published Boolean  @default(false)
  title     String
  content   String
}

model Checkout {
  id                Int       @id @default(autoincrement())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deleted           Boolean   @default(false)
  transactionId     String?
  AuthId            Int
  amount            Float
  paid              Boolean   @default(false)
  period            String    @default("")
  auth              Auth      @relation(fields: [AuthId], references: [id])
  product           String?
  cancelSubscripton Boolean
  pause             Boolean   @default(false)
  nextBillingDate   DateTime?
  startDate         DateTime?

  refunds CheckoutRefund[]
}

model CheckoutRefund {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkoutId Int
  checkout   Checkout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  currency String @default("usd")
  amount   Int    @default(0)

  chargeAmount        Int     @default(0)
  amountRefundedTotal Int     @default(0)
  remainingRefundable Int     @default(0)
  fullyRefunded       Boolean @default(false)

  stripeRefundId        String  @unique
  stripePaymentIntentId String?
  stripeChargeId        String
  sourceTransactionId   String?

  status        String?
  reason        String?
  failureReason String?

  reverseTransfer      Boolean @default(false)
  refundApplicationFee Boolean @default(false)

  @@index([checkoutId])
  @@index([stripePaymentIntentId])
  @@index([stripeChargeId])
  @@index([status])
}

model FrequentQuestions {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
  title     String
  text      String
}

model Affiliate {
  id                Int      @id @default(autoincrement())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deleted           Boolean  @default(false)
  approved          Boolean
  link              String
  uuid              String
  userId            Int      @unique
  digitalBillboards Int      @default(0)
  pageHits          Int      @default(0)
  User              User     @relation(fields: [userId], references: [id])
  SignUp            SignUp[]
}

model Careers {
  id          Int          @id @default(autoincrement())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deleted     Boolean      @default(false)
  title       String?
  description String?
  location    String?
  salary      Int?
  image       String?
  type        Type
  Applicants  Applicants[]
}

enum Type {
  Job
  Recruitment
}

model Applicants {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
  careersId Int
  firstName String
  lastName  String
  email     String
  phone     String
  resume    String
  career    Careers  @relation(fields: [careersId], references: [id])
}

model Consultation {
  id                      Int      @id @default(autoincrement())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  deleted                 Boolean  @default(false)
  fullName                String
  companyName             String
  location                String
  jobTitle                String
  email                   String
  phone                   String
  numOfPositions          Int
  dateTime                DateTime
  totalAmount             Int
  currency                String
  stripeCheckoutSessionId String
  stripePaymentIntentId   String
  paidAt                  DateTime
  status                  String   @default("pending")
}

model Blogpost {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deleted     Boolean  @default(false)
  title       String
  slug        String   @unique
  postContent String
  category    String
  views       Int      @default(0)
  headerImage String?
  featured    Boolean  @default(false)
}

model Subscription {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deleted       Boolean  @default(false)
  transactionId String?
  amount        Float
  paid          Boolean  @default(false)
  AuthId        Int      @unique
  auth          Auth     @relation(fields: [AuthId], references: [id])
}

model Notes {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  title      String
  content    String
  authorName String?
  auth       Auth     @relation(fields: [authId], references: [id])
  authId     Int
}

model Advertiser {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deleted       Boolean  @default(false)
  approved      Boolean?
  userId        Int      @unique
  website       String?
  twitter       String?
  youtube       String?
  facebook      String?
  linkedIn      String?
  instagram     String?
  businessImage String?
  companyName   String?
  podcast       String?
  companyBlurb  String?
  User          User     @relation(fields: [userId], references: [id])
}

model Legal {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
  title     String
  content   String?
}

model AffiliateAgreement {
  id                 Int      @id @default(autoincrement())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  affiliateAgreement String
}

model Gdpr {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gdpr      String
}

model Terms {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  terms     String
}

model RiskDisclosure {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  riskDisclosure String
}

model PrivacyPolicy {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  privacyPolicy String
}

model DigitalBillboard {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  fullName    String
  website     String
  podcast     String
  twitter     String
  youTube     String
  facebook    String
  image       String
  companyName String
  description String
  status      Status
  authId      Int? // optional foreign key
  Auth        Auth?    @relation(fields: [authId], references: [id]) // optional relation
}

enum Status {
  Approved
  NotApproved
  Rejected
}

// invoice 

model Contract {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  name         String   @default("")
  contractName String   @default("")
  email        String   @default("")

  businessName String @default("")
  pdf          String
  signed       String @default("notSigned")

  authId           Int?
  Auth             Auth?             @relation(fields: [authId], references: [id])
  invoices         Invoice[]
  subscriptionInvs SubscriptionInv[]
}

model Invoice {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  name         String   @default("")
  email        String   @default("")
  businessName String   @default("")
  price        String   @default("")

  paidImage   String @default("")
  unpaidImage String @default("")

  transactionId String?
  paid          Boolean @default(false)

  paymentType          String @default("one_time")
  subscriptionInterval String @default("month")

  currency             String @default("usd")
  baseAmount           Int    @default(0)
  serviceFeePercent    Float  @default(3)
  platformFeePercent   Float  @default(5)
  serviceFeeAmount     Int    @default(0)
  platformFeeAmount    Int    @default(0)
  applicationFeeAmount Int    @default(0)
  totalAmount          Int    @default(0)

  stripeCheckoutSessionId  String?
  stripePaymentIntentId    String?
  stripeChargeId           String?
  stripeSubscriptionId     String?
  stripeCustomerId         String?
  stripeLatestInvoiceId    String?
  stripeSubscriptionStatus String?
  stripeCurrentPeriodEnd   DateTime?
  stripeCancelAtPeriodEnd  Boolean   @default(false)
  subscriptionStartedAt    DateTime?
  subscriptionCanceledAt   DateTime?

  refunded             Boolean   @default(false)
  refundedAmount       Int       @default(0)
  stripeLatestRefundId String?
  stripeRefundStatus   String?
  refundedAt           DateTime?

  contractId Int?
  Contract   Contract? @relation(fields: [contractId], references: [id])

  authId Int?
  auth   Auth? @relation(fields: [authId], references: [id])

  invoicePayments InvoicePayment[]
  invoiceRefunds  InvoiceRefund[]

  @@index([paymentType])
  @@index([stripeCheckoutSessionId])
  @@index([stripePaymentIntentId])
  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
}

model InvoicePayment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  paymentType String @default("one_time")
  currency    String @default("usd")

  baseAmount           Int @default(0)
  serviceFeeAmount     Int @default(0)
  platformFeeAmount    Int @default(0)
  applicationFeeAmount Int @default(0)
  amountPaid           Int @default(0)

  stripeCheckoutSessionId String?
  stripePaymentIntentId   String? @unique
  stripeChargeId          String?
  stripeInvoiceId         String?
  stripeSubscriptionId    String?
  stripeCustomerId        String?

  paymentStatus String?
  paidAt        DateTime?

  refunded       Boolean @default(false)
  refundedAmount Int     @default(0)

  refunds InvoiceRefund[]

  @@index([invoiceId])
  @@index([stripeSubscriptionId])
  @@index([stripeInvoiceId])
  @@index([stripeChargeId])
}

model InvoiceRefund {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  invoicePaymentId Int?
  invoicePayment   InvoicePayment? @relation(fields: [invoicePaymentId], references: [id], onDelete: SetNull)

  currency String @default("usd")
  amount   Int    @default(0)

  stripeRefundId        String? @unique
  stripePaymentIntentId String?
  stripeChargeId        String?
  stripeSubscriptionId  String?

  status String?
  reason String?

  reverseTransfer      Boolean @default(true)
  refundApplicationFee Boolean @default(true)
  cancelSubscription   Boolean @default(false)
  cancelAtPeriodEnd    Boolean @default(false)

  createdByAuthId Int?

  @@index([invoiceId])
  @@index([invoicePaymentId])
  @@index([stripePaymentIntentId])
  @@index([stripeChargeId])
}

model SubscriptionInv {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  name         String   @default("")
  email        String   @default("")
  businessName String   @default("")
  price        String   @default("")

  paidImage   String @default("")
  unpaidImage String @default("")

  transactionId String?
  paid          Boolean @default(false)

  paymentType          String @default("subscription")
  subscriptionInterval String @default("month")

  currency             String @default("usd")
  baseAmount           Int    @default(0)
  serviceFeePercent    Float  @default(3)
  platformFeePercent   Float  @default(5)
  serviceFeeAmount     Int    @default(0)
  platformFeeAmount    Int    @default(0)
  applicationFeeAmount Int    @default(0)
  totalAmount          Int    @default(0)

  stripeCheckoutSessionId  String?
  stripePaymentIntentId    String?
  stripeChargeId           String?
  stripeSubscriptionId     String?
  stripeCustomerId         String?
  stripeLatestInvoiceId    String?
  stripeSubscriptionStatus String?
  stripeCurrentPeriodEnd   DateTime?
  stripeCancelAtPeriodEnd  Boolean   @default(false)
  subscriptionStartedAt    DateTime?
  subscriptionCanceledAt   DateTime?

  refunded             Boolean   @default(false)
  refundedAmount       Int       @default(0)
  stripeLatestRefundId String?
  stripeRefundStatus   String?
  refundedAt           DateTime?

  contractId Int?
  Contract   Contract? @relation(fields: [contractId], references: [id])

  authId Int?
  auth   Auth? @relation(fields: [authId], references: [id])

  subscriptionInvPayments SubscriptionInvPayment[]
  subscriptionInvRefunds  SubscriptionInvRefund[]

  @@index([paymentType])
  @@index([stripeCheckoutSessionId])
  @@index([stripePaymentIntentId])
  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
}

model SubscriptionInvPayment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptionInvId Int
  subscriptionInv   SubscriptionInv @relation(fields: [subscriptionInvId], references: [id], onDelete: Cascade)

  paymentType String @default("one_time")
  currency    String @default("usd")

  baseAmount           Int @default(0)
  serviceFeeAmount     Int @default(0)
  platformFeeAmount    Int @default(0)
  applicationFeeAmount Int @default(0)
  amountPaid           Int @default(0)

  stripeCheckoutSessionId String?
  stripePaymentIntentId   String? @unique
  stripeChargeId          String?
  stripeInvoiceId         String?
  stripeSubscriptionId    String?
  stripeCustomerId        String?

  paymentStatus String?
  paidAt        DateTime?

  refunded       Boolean @default(false)
  refundedAmount Int     @default(0)

  refunds SubscriptionInvRefund[]

  @@index([subscriptionInvId])
  @@index([stripeSubscriptionId])
  @@index([stripeInvoiceId])
  @@index([stripeChargeId])
}

model SubscriptionInvRefund {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptionInvId Int
  subscriptionInv   SubscriptionInv @relation(fields: [subscriptionInvId], references: [id], onDelete: Cascade)

  subscriptionInvPaymentId Int?
  subscriptionInvPayment   SubscriptionInvPayment? @relation(fields: [subscriptionInvPaymentId], references: [id], onDelete: SetNull)

  currency String @default("usd")
  amount   Int    @default(0)

  stripeRefundId        String? @unique
  stripePaymentIntentId String?
  stripeChargeId        String?
  stripeSubscriptionId  String?

  status String?
  reason String?

  reverseTransfer      Boolean @default(true)
  refundApplicationFee Boolean @default(true)
  cancelSubscription   Boolean @default(false)
  cancelAtPeriodEnd    Boolean @default(false)

  createdByAuthId Int?

  @@index([subscriptionInvId])
  @@index([subscriptionInvPaymentId])
  @@index([stripePaymentIntentId])
  @@index([stripeChargeId])
}

model ToolFeedback {
  id        Int      @id @default(autoincrement())
  authId    Int
  review    String
  stars     String
  toolName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Auth Auth @relation(fields: [authId], references: [id])
}
