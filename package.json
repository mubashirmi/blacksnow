{
    "name": "blacksnow",
    "version": "0.9.5",
    "private": true,
    "scripts": {
        "dev": "concurrently -n WEB,CRON -c auto \"next dev\" \"ts-node --esm scripts/email-cron.ts\"",
        "build": "next build",
        "start": "concurrently -k -n WEB,CRON -c auto \"next start\" \"ts-node -r tsconfig-paths/register scripts/email-cron.ts\"",
        "cron:dev": "ts-node scripts/email-cron.ts",
        "cron:start": "ts-node scripts/email-cron.ts",
        "lint": "next lint",
        "lint:fix": "next lint --fix",
        "generate": "npx prisma generate",
        "migrate": "prisma migrate dev --name",
        "prettier": "prettier --write .",
        "prepare": "husky install",
        "postinstall": "npx prisma generate",
        "seed": "node prisma/seeds/seed.ts"
    },
